# Port for standalone Express server (default 5000)
PORT=5000

# Environment mode ('development' or 'production')
NODE_ENV=production

# Allowed CORS origins for frontend access (comma-separated, or '*' for wildcard)
ALLOWED_ORIGINS=https://akskriitk.github.io,http://localhost:5173

# Primary Frontend URL
FRONTEND_URL=https://akskriitk.github.io

# Google Sheets Webhook URL (from Google Apps Script deployment)
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID_HERE/exec
